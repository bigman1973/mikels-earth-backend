# Stripe Configuration
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=generate_a_unique_secret_in_your_deployment_platform
JWT_SECRET=generate_a_unique_jwt_secret_in_your_deployment_platform
ADMIN_SECRET_KEY=generate_a_unique_admin_secret_in_your_deployment_platform

# Cloudflare Turnstile (server-side secret; never expose it to the browser)
TURNSTILE_SECRET_KEY=set_in_your_deployment_platform

# Database
DATABASE_URL=sqlite:///src/database/app.db

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Production values (uncomment and update for production):
# STRIPE_SECRET_KEY=set_in_your_deployment_platform
# STRIPE_PUBLISHABLE_KEY=set_in_your_deployment_platform
# STRIPE_WEBHOOK_SECRET=set_in_your_deployment_platform
# FLASK_ENV=production
# FLASK_DEBUG=False
# DATABASE_URL=postgresql://user:password@host:port/database
# FRONTEND_URL=https://mikels.es
