# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-very-secure-secret-key-change-this

# Database
DATABASE_URL=sqlite:///src/database/app.db

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:5173

# Meta Conversions API (set only in protected Railway variables)
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=

# Klaviyo private key (set only in protected Railway variables)
KLAVIYO_API_KEY=
# Optional: once created automatically, its value may be pinned in Railway.
KLAVIYO_VIP_LIST_ID=

# VIP/contact keyless security: existing PostgreSQL + explicit SQL migration.
# No extra secret: stable Flask SECRET_KEY provides the IP HMAC key.
# BLOCK deployment behind Railway until peer/header trust is verified.
# direct ignores all forwarded headers; not suitable for an unverified proxy.
FORM_CLIENT_IP_MODE=direct
# verified_header requires BOTH values below, from verified real ingress data.
# Do not guess Railway CIDRs/header names or use universal trust (0.0.0.0/0).
FORM_TRUSTED_PROXY_CIDRS=
FORM_VERIFIED_IP_HEADER=

# The public Meta catalogue feed is served at /api/meta-catalog/products.csv.
# It needs no additional secret and derives its values from WebProduct.

# Brevo Email Configuration (optional, for email notifications)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=noreply@mikels.es
BREVO_SENDER_NAME=Mikel's Earth

# Production values (uncomment and update for production):
# STRIPE_SECRET_KEY=sk_live_your_live_stripe_secret_key
# STRIPE_PUBLISHABLE_KEY=pk_live_your_live_stripe_publishable_key
# STRIPE_WEBHOOK_SECRET=whsec_your_production_webhook_secret
# FLASK_ENV=production
# FLASK_DEBUG=False
# DATABASE_URL=postgresql://user:password@host:port/database
# FRONTEND_URL=https://mikels.es
